{
  "installCommand": "pnpm install --no-frozen-lockfile --ignore-scripts",
  "buildCommand": "DEPLOY_BASE=/ pnpm exec vite build --config vite.static.config.ts",
  "outputDirectory": "dist-static",
  "rewrites": [
    {
      "source": "/((?!assets/|game/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/game/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)"
        }
      ]
    }
  ]
}
